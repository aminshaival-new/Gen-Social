# ── Claude API (post ideas, captions, brand analysis) ────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI API (GPT Image 2 — slide image generation) ────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Blotato (Instagram scheduling) ───────────────────────────
# Get your API key at: https://blotato.com/settings/api
# Account ID = your Instagram account ID inside Blotato
BLOTATO_API_KEY=blt_...
BLOTATO_ACCOUNT_ID=...

# ── Server port (optional, default 3000) ─────────────────────
PORT=3000
