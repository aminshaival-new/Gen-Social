# ── OpenRouter (routes to Claude for ideas, captions, brand analysis) ──
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── Fal AI (FLUX Pro image generation for carousel slides) ─────────────
# Get your key at: https://fal.ai/dashboard/keys
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Blotato (Instagram scheduling) ────────────────────────────────────
# Get your key at: https://blotato.com/settings/api
BLOTATO_API_KEY=blt_...
# Your Instagram account ID inside Blotato (Settings → Accounts)
BLOTATO_ACCOUNT_ID=

# ── Server port (optional, default 3000) ─────────────────────────────
PORT=3000
