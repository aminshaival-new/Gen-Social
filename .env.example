# ── OpenRouter (routes to Claude for ideas, captions, brand analysis) ──
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── OpenAI (GPT Image 2 / gpt-image-1 for carousel slides) ────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Blotato (Instagram scheduling) ────────────────────────────────────
# Get your key at: https://blotato.com/settings/api
BLOTATO_API_KEY=blt_...
# Your Instagram account ID inside Blotato (Settings → Accounts)
BLOTATO_ACCOUNT_ID=

# ── Login credentials (set these in Railway env vars, never commit) ───
AUTH_USER=yourclientusername
AUTH_PASS=yourclientpassword
# Generate a random string for SESSION_SECRET — e.g.: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-64-char-string

# ── Railway sets PORT automatically — do not add it there ─────────────
PORT=3000
